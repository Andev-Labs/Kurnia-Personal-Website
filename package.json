{
  "name": "kurnia-personal-website",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "typecheck": "pnpm i18n:compile && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.2",
    "@inlang/paraglide-js-react": "^1.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.54",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.36",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
